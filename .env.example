# 部署时复制为 .env（cp .env.example .env），然后改下面带【改】的值
# 生产环境务必：chmod 600 .env；SECRET_KEY 用随机值；不要用 root 连库

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pets_app
DB_PASSWORD=【改成强密码】
DB_NAME=pets

# 生成方法：python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=【改成随机64位十六进制】

# 生产必须 0（1 会开调试模式，严重安全问题）
FLASK_DEBUG=0
